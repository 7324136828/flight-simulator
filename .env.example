# Settings in %APPDATA%/flight-simulator/settings.json supply ports and data_directory.
# Optional port overrides for source development (busy ports advance to a free one):
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
# LAN is enabled by default. Use 127.0.0.1 for local-only development.
BACKEND_HOST=0.0.0.0

# Optional database override; otherwise stored in settings.json's data_directory.
# DATABASE_PATH=D:/FlightData/flight_simulator.db

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
