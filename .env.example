# Preferred ports. If either is busy, run.py advances until it finds a free one.
BACKEND_PORT=8000
FRONTEND_PORT=5173
BACKEND_HOST=127.0.0.1

# Persistent SQLite database location
DATABASE_PATH=data/flight_simulator.db

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
